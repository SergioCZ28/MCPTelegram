# Telegram MCP configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` to git. It is already in .gitignore.
#
# How to get API_ID and API_HASH:
#   1. Go to https://my.telegram.org
#   2. Log in with your phone number
#   3. Click "API development tools"
#   4. Create a new application (any name/description is fine)
#   5. Copy the api_id (integer) and api_hash (string) shown
#
# Keep these values private -- anyone with them can impersonate your app.
# -----------------------------------------------------------------------------

# Your Telegram API credentials (from https://my.telegram.org)
TG_API_ID=1234567
TG_API_HASH=your_api_hash_here_32_characters_long

# Your phone number in international format (e.g., +41791234567)
TG_PHONE=+41791234567

# Optional: where to store the Telethon session file.
# Default: ~/.config/telegram-mcp/telegram.session
# Leave unset to use the default.
# TG_SESSION_PATH=C:/Users/yourname/.config/telegram-mcp/telegram.session
